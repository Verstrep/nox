// Schema Prisma de NOX.
//
// L'URL de la source de donnees n'est PAS declaree ici : elle est resolue par
// `prisma.config.ts`, qui calcule un chemin absolu a partir de la racine du
// monorepo. Voir `src/paths.ts`.

// Le client est genere sous `src/` (et non a cote) pour etre compile par `tsc`
// avec le reste du package : le generateur `prisma-client` de Prisma 7 emet du
// TypeScript, pas du JavaScript. Le dossier genere n'est pas versionne.
//
// `importFileExtension` est fige a "js" : sans cela, le generateur la deduit du
// tsconfig le plus proche et emet des imports en `.ts` des que
// `allowImportingTsExtensions` est actif. `tsc` ne reecrit pas ces extensions,
// ce qui produirait un `dist/` invalide a l'execution.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// Un projet NOX : un repository Git local suivi par l'application.
///
/// `status` est stocke sous forme de chaine : SQLite ne connait pas les enums,
/// et les statuts sont deja definis une seule fois dans `@nox/shared`
/// (`ProjectStatus`). La validation est faite dans la couche applicative par
/// `isProjectStatus`, ce qui evite de dupliquer la liste ici.
model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  repositoryPath String   @unique
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Prochain numero de tache a attribuer dans ce projet.
  ///
  /// Ce compteur ne decrit pas le nombre de taches : il ne recule jamais, meme
  /// si une creation echoue apres reservation. Un trou dans la numerotation est
  /// prefere a la reutilisation d'un identifiant qui a pu circuler dans Git,
  /// dans un log ou dans une conversation.
  nextTaskSequence Int @default(1)

  tasks Task[]
}

/// Une tache de developpement : la specification d'une unite de travail.
///
/// Le code affiche (`TASK-001`) n'est pas stocke : il se derive de `sequence`,
/// qui est immuable. Deux representations d'une meme verite finissent toujours
/// par diverger ; une seule ne le peut pas.
///
/// `status`, `priority` et `documentSyncStatus` sont des chaines : SQLite ne
/// connait pas les enums, et ces listes sont deja definies une seule fois dans
/// `@nox/shared`. La validation est faite a la relecture, par la couche
/// applicative.
model Task {
  id        String @id @default(cuid())
  projectId String

  /// Numero attribue a la creation, unique dans le projet et jamais modifie.
  sequence Int

  title      String
  objective  String
  context    String?
  outOfScope String?

  status   String
  priority String

  /// Chemin relatif du Markdown associe : `tasks/TASK-001.md`.
  documentPath String

  /// Empreinte du document, connue seulement lorsqu'il est synchronise.
  documentRevision String?

  documentSyncStatus String
  documentSyncError  String?

  /// Prochain numero d'execution a attribuer pour cette tache.
  ///
  /// Meme regle que `Project.nextTaskSequence` : il ne recule jamais, et un
  /// trou vaut mieux qu'un `RUN-002` qui designerait deux executions.
  nextRunSequence Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  acceptanceCriteria TaskAcceptanceCriterion[]
  documentReferences TaskDocumentReference[]
  validationCommands TaskValidationCommand[]
  runs               Run[]
  reviewFeedbacks    ReviewFeedback[]

  @@unique([projectId, sequence])
  @@index([projectId, status])
}

/// Une execution : un passage de Claude Code sur une tache.
///
/// Le prompt est conserve **exactement** tel qu'il a ete envoye, avec son
/// empreinte. C'est ce qui rend une execution relisible des mois plus tard :
/// la specification de la tache aura pu evoluer, le prompt reellement envoye,
/// non.
///
/// Les champs Claude et Git sont facultatifs : ils n'existent qu'une fois le
/// processus termine, et certains ne sont pas garantis par toutes les versions
/// de Claude Code. Aucune valeur n'est inventee pour combler un manque.
model Run {
  id     String @id @default(cuid())
  taskId String

  /// Numero attribue a la creation, unique dans la tache et jamais modifie.
  sequence Int

  status String

  /// Valeur de `RunKind` : `INITIAL` ou `CORRECTION`.
  ///
  /// Une correction n'est pas une execution un peu differente : c'est une
  /// execution qui part d'un dossier de travail volontairement sale, celui-la
  /// meme qui vient d'etre relu. La distinguer explicitement evite qu'un futur
  /// changement de preflight ne s'applique par erreur aux deux.
  kind String @default("INITIAL")

  /// Execution relue dont cette correction reprend la session.
  ///
  /// `null` pour un run initial. `Restrict` en cascade : le parent est un fait
  /// historique, et une correction qui le referencerait dans le vide raconterait
  /// une reprise dont on aurait perdu le point de depart.
  parentRunId String?

  /// Session Claude **demandee** au lancement d'une correction.
  ///
  /// Distincte de `claudeSessionId`, qui porte celle que l'execution a
  /// **rapportee**. Les deux coincident en pratique — le binaire conserve
  /// l'identifiant a la reprise —, mais les confondre reviendrait a supposer un
  /// comportement plutot qu'a l'enregistrer.
  resumedFromSessionId String?

  prompt       String
  promptSha256 String

  /// Identifiant transmis au runner ; cle de son registre en memoire.
  runnerRunId String

  claudeSessionId String?
  resultText      String?
  stderrTail      String?

  exitCode     Int?
  errorCode    String?
  errorMessage String?

  durationMs      Int?
  durationApiMs   Int?
  numTurns        Int?
  /// Cout rapporte par Claude Code. Jamais calcule ni estime par NOX.
  reportedCostUsd Float?

  gitBranch     String?
  gitUpstream   String?
  gitHeadBefore String?
  gitHeadAfter  String?
  gitDiffStat   String?
  /// Chemins relatifs des fichiers modifies, un par ligne.
  changedFiles  String?

  startedAt  DateTime?
  finishedAt DateTime?

  /// Date a laquelle un humain a demande l'arret de cette execution.
  ///
  /// Le seul des trois champs proposes par TASK-010 qui ait ete retenu. Il
  /// enregistre un fait qu'aucune autre colonne ne porte : quelqu'un a decide
  /// d'interrompre, et cette decision doit survivre a un redemarrage du runner.
  ///
  /// `cancelledAt` n'existe pas : `finishedAt` avec `status = CANCELLED` dit
  /// exactement la meme chose. `lastEventSequence` non plus : il se derive du
  /// `MAX(sequence)` des `RunEvent`, et un compteur denormalise finirait par
  /// diverger des lignes qu'il pretend compter — l'inverse de l'idempotence
  /// recherchee.
  cancellationRequestedAt DateTime?

  /// Moment ou l'instantane de review a ete enregistre.
  ///
  /// Non nul signifie « la capture a eu lieu », y compris lorsqu'elle n'a trouve
  /// aucun changement. Une review vide et une review absente sont deux choses
  /// differentes : la premiere dit « l'agent n'a rien modifie », la seconde dit
  /// « NOX ne sait pas ». Les confondre inventerait une precision qui n'existe
  /// pas, et c'est exactement ce qui distingue un run d'avant TASK-011 d'un run
  /// sans changement.
  reviewCapturedAt DateTime?

  /// Code d'erreur de la capture detaillee, lorsqu'elle a echoue.
  ///
  /// Distinct de `errorCode` : celui-ci porte l'echec de l'execution, celui-la
  /// l'echec de sa relecture. Un diff que NOX n'a pas su capturer ne transforme
  /// jamais un succes de Claude Code en echec.
  reviewErrorCode String?

  /// Fichiers changes mais non decrits, faute de place.
  ///
  /// Le seul compteur stocke de la review, parce qu'il est le seul a ne pas etre
  /// derivable : les lignes absentes ne peuvent pas se compter elles-memes. Tout
  /// le reste — additions, suppressions, fichiers sensibles, patches tronques —
  /// se calcule a partir des `RunFileChange`.
  reviewOmittedFiles Int @default(0)

  /// Empreinte opaque du dossier de travail a la fin de l'execution.
  ///
  /// Un HMAC hexadecimal, dont la cle est derivee du jeton du runner et n'est
  /// jamais stockee ici. Elle n'est **jamais** rendue au navigateur : elle ne sert
  /// qu'a repondre a une question, cote serveur — « le dossier de travail est-il
  /// encore exactement celui qui a ete relu ? ».
  ///
  /// `null` pour toute execution anterieure a TASK-012, qui n'est donc pas
  /// reprenable. C'est voulu : une empreinte reconstituee apres coup decrirait le
  /// present en pretendant decrire le passe.
  workspaceFingerprint String?

  /// Version de l'algorithme d'empreinte, pour qu'un changement soit detectable.
  workspaceFingerprintVersion String?

  /// Code d'erreur du calcul d'empreinte, lorsqu'il a echoue.
  ///
  /// Distinct de `reviewErrorCode` : une review peut parfaitement aboutir alors
  /// que l'empreinte a bute sur une borne. La premiere sert a lire, la seconde a
  /// autoriser une reprise.
  workspaceFingerprintErrorCode String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// `Restrict` et non `Cascade`, contrairement aux trois tables enfant de
  /// `Task` : un critere d'acceptation n'a aucun sens sans sa tache, alors qu'une
  /// execution est un fait historique. Elle a consomme du quota, modifie un
  /// repository et produit un compte rendu ; la faire disparaitre parce que la
  /// tache disparait effacerait la trace de ce qui s'est reellement passe.
  ///
  /// Cette contrainte double la regle metier de `deleteTaskWithoutRuns`. Ce
  /// n'est pas une redondance : la regle metier produit un message utile, la
  /// contrainte tient meme si quelqu'un l'ignore et appelle Prisma directement.
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  events      RunEvent[]
  fileChanges RunFileChange[]
  validations RunValidationResult[]

  feedbacks          ReviewFeedback[] @relation("ReviewFeedbackSource")
  triggeringFeedback ReviewFeedback?  @relation("ReviewFeedbackCorrection")

  /// `parentRunId` est une colonne, pas une relation Prisma.
  ///
  /// L'index unique est la garantie qui compte : il interdit qu'une meme
  /// execution recoive deux corrections, y compris sur double clic concurrent.
  /// La cle etrangere, elle, n'est pas declaree — `ALTER TABLE ADD COLUMN` ne
  /// sait pas en creer sous SQLite, et la seule alternative aurait ete de
  /// reconstruire une table qui porte l'historique reel des executions.
  ///
  /// Elle ne protegerait de toute facon contre rien d'atteignable : **aucune
  /// execution n'est jamais supprimee dans NOX**, donc aucun parent ne peut
  /// disparaitre. Le schema decrit ici exactement ce que la base contient, plutot
  /// que d'annoncer une contrainte qui n'existe pas.
  @@unique([taskId, sequence])
  @@unique([parentRunId])
  @@index([taskId, status])
}

/// Le texte par lequel un humain demande une correction apres une review.
///
/// ## Pourquoi il est persiste
///
/// Parce qu'il fait partie de l'histoire de la tache au meme titre que le prompt
/// et le diff. Six mois plus tard, « pourquoi RUN-002 existe-t-il ? » n'a qu'une
/// bonne reponse : le texte exact que l'utilisateur avait ecrit. Le regenerer ou
/// le resumer le rendrait faux.
///
/// ## Pourquoi il est immuable une fois utilise
///
/// Un feedback vaut pour **une** correction. Le modifier apres coup ferait mentir
/// le prompt deja envoye ; le reutiliser lancerait deux reprises de la meme
/// session avec le meme texte, ce qu'un double clic suffirait a provoquer.
/// `correctionRunId` est donc unique, et sa pose est la prise du verrou.
model ReviewFeedback {
  id     String @id @default(cuid())
  taskId String

  /// Execution relue au moment ou le feedback a ete ecrit.
  sourceRunId String

  /// Texte exact, normalise en fins de ligne `\n` et borne.
  text String

  /// Correction lancee depuis ce feedback, une fois seulement.
  correctionRunId String?

  createdAt DateTime  @default(now())
  usedAt    DateTime?

  /// `Restrict` comme `Run` → `Task` : un feedback est un fait historique, et il
  /// documente une execution que rien ne supprime.
  task          Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceRun     Run  @relation("ReviewFeedbackSource", fields: [sourceRunId], references: [id], onDelete: Restrict)
  correctionRun Run? @relation("ReviewFeedbackCorrection", fields: [correctionRunId], references: [id], onDelete: Restrict)

  @@unique([correctionRunId])
  @@index([taskId, createdAt])
  @@index([sourceRunId])
}

/// Un fichier change par une execution, tel qu'il l'etait a la fin de celle-ci.
///
/// ## Un instantane, pas une vue
///
/// Ces lignes sont ecrites **une fois**, au moment ou l'execution devient
/// finale, et ne sont plus jamais recalculees. C'est toute la difference entre
/// une review et un `git diff` : le second raconte le present du disque, la
/// premiere raconte ce que l'agent avait produit. Si l'utilisateur edite un
/// fichier apres coup — ce qui est exactement ce qu'on attend de lui —, la
/// review historique doit continuer de dire la verite sur le passe.
///
/// ## Ce qui n'entre jamais ici
///
/// Aucun blob binaire : pour un fichier binaire, `patch` vaut `null` et
/// `isBinary` porte l'information. Aucun contenu de fichier sensible : un `.env`
/// apparait par son chemin et ses statistiques, jamais par son texte. Aucun
/// fichier entier hors d'un patch borne : au-dela des limites de `REVIEW_LIMITS`,
/// `isTruncated` le dit explicitement plutot que de couper en silence.
///
/// `path` est **toujours** relatif au repository, separateurs `/`. Un chemin
/// absolu est refuse par le contrat partage avant d'arriver jusqu'ici.
model RunFileChange {
  id    String @id @default(cuid())
  runId String

  /// Rang stable dans la review, attribue a la capture.
  ///
  /// L'ordre n'est pas cosmetique : c'est lui qui rend deux affichages de la
  /// meme review identiques, et une navigation par `?file=` reproductible.
  position Int

  path String
  /// Renseigne uniquement pour un renommage ou une copie.
  previousPath String?

  /// Valeur de `RunChangeType`, stockee en chaine comme les autres enums.
  changeType String

  /// Comptes rapportes par Git ; `null` lorsqu'il n'en fournit pas (binaire).
  additions Int?
  deletions Int?

  isBinary    Boolean @default(false)
  isSensitive Boolean @default(false)
  isTruncated Boolean @default(false)

  /// Diff unifie, ou `null` : binaire, sensible, ou au-dela des bornes.
  patch String?

  createdAt DateTime @default(now())

  /// `Cascade`, comme `RunEvent` : un changement de fichier ne raconte rien sans
  /// son execution, et rien d'autre ne le referencera jamais.
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId, position])
}

/// Une commande de validation attendue par la tache, et ce qu'elle est devenue.
///
/// ## Pourquoi la commande est recopiee
///
/// Le texte de la commande est **copie** depuis la tache a la creation de
/// l'execution, jamais simplement reference. Une specification evolue ; la review
/// d'une execution passee, non. Sans cette copie, corriger `npm run test` en
/// `npm test` dans la tache reecrirait l'histoire de tous les runs precedents.
///
/// ## Ce que le statut represente
///
/// Uniquement ce que Claude Code a **reellement** execute pendant le run. NOX ne
/// relance aucune commande pour completer le tableau : une commande `NOT_RUN`
/// est une information, pas un trou a combler.
model RunValidationResult {
  id    String @id @default(cuid())
  runId String

  /// Rang dans la tache, recopie a la creation de l'execution.
  position Int

  /// Texte exact, tel qu'il etait au lancement.
  command String

  /// Valeur de `RunValidationStatus`, stockee en chaine.
  status String

  /// Code de sortie **rapporte** par l'outil ; jamais deduit ni invente.
  exitCode Int?
  /// Resume borne et nettoye de la sortie, lorsqu'il y en a un.
  summary  String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId, position])
}

/// Un evenement public d'une execution, tel qu'il a ete affiche.
///
/// ## Ce qui est stocke ici a deja ete nettoye
///
/// Les lignes brutes de Claude Code n'atteignent jamais cette table. Ce qui y
/// arrive a traverse le normaliseur puis le nettoyeur du runner : chemins rendus
/// relatifs, secrets retires, raisonnement interne ecarte, tailles bornees. La
/// base n'est pas une seconde barriere de securite — elle est *derriere* la
/// barriere, et c'est pour cela qu'aucune sanitation n'est refaite a la lecture.
///
/// ## Pourquoi persister ce que le registre possede deja
///
/// Le registre du runner est en memoire : un redemarrage l'efface. Sans cette
/// table, rouvrir la page d'une execution passee n'afficherait plus rien de ce
/// qui s'est passe pendant qu'elle tournait. Les evenements sont la mémoire
/// longue ; le registre n'est que la fenetre du direct.
///
/// `runId + sequence` est unique : c'est ce couple qui rend la persistance
/// idempotente. Le flux SSE peut renvoyer deux fois le meme evenement — deux
/// onglets, une reconnexion — sans jamais creer de doublon.
model RunEvent {
  id    String @id @default(cuid())
  runId String

  /// Numero attribue par le runner, strictement croissant dans l'execution.
  sequence Int

  /// Valeur de `ClaudeRunEventKind`, stockee en chaine comme les autres enums.
  kind String

  label   String
  detail  String?
  toolName String?
  isError Boolean @default(false)

  /// Date produite par le runner, jamais reprise de Claude Code.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  /// `Cascade`, contrairement a la relation `Run` → `Task`.
  ///
  /// Un evenement n'a aucun sens sans son execution : il ne raconte rien tout
  /// seul, et rien ne le referencera jamais. La regle qui protege l'historique
  /// porte sur les executions elles-memes — et la suppression d'une execution
  /// n'existe nulle part dans NOX.
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

/// Un critere d'acceptation, a la position ou l'utilisateur l'a saisi.
///
/// Aucune case « terminee » : cette table decrit ce qui devra etre vrai a la
/// fin, pas ce qui l'est deja. Le resultat d'une execution appartiendra a un
/// autre modele, quand NOX saura lancer Claude Code.
model TaskAcceptanceCriterion {
  id        String   @id @default(cuid())
  taskId    String
  position  Int
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}

/// Un document que l'agent devra lire avant d'implementer la tache.
///
/// Le chemin est relatif au repository et n'est pas verifie sur le disque : une
/// tache peut legitimement referencer un fichier qui sera cree avant son
/// execution.
model TaskDocumentReference {
  id        String   @id @default(cuid())
  taskId    String
  position  Int
  path      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}

/// Une commande de validation declaree par la tache.
///
/// Elle est stockee comme du texte et n'est **jamais** executee : NOX ne sait
/// pas encore lancer de processus depuis une tache, et rien ici n'ouvre ce
/// droit.
model TaskValidationCommand {
  id        String   @id @default(cuid())
  taskId    String
  position  Int
  command   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}
