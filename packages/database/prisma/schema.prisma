// Schema Prisma de NOX.
//
// L'URL de la source de donnees n'est PAS declaree ici : elle est resolue par
// `prisma.config.ts`, qui calcule un chemin absolu a partir de la racine du
// monorepo. Voir `src/paths.ts`.

// Le client est genere sous `src/` (et non a cote) pour etre compile par `tsc`
// avec le reste du package : le generateur `prisma-client` de Prisma 7 emet du
// TypeScript, pas du JavaScript. Le dossier genere n'est pas versionne.
//
// `importFileExtension` est fige a "js" : sans cela, le generateur la deduit du
// tsconfig le plus proche et emet des imports en `.ts` des que
// `allowImportingTsExtensions` est actif. `tsc` ne reecrit pas ces extensions,
// ce qui produirait un `dist/` invalide a l'execution.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// Un projet NOX : un repository Git local suivi par l'application.
///
/// `status` est stocke sous forme de chaine : SQLite ne connait pas les enums,
/// et les statuts sont deja definis une seule fois dans `@nox/shared`
/// (`ProjectStatus`). La validation est faite dans la couche applicative par
/// `isProjectStatus`, ce qui evite de dupliquer la liste ici.
model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  repositoryPath String   @unique
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Prochain numero de tache a attribuer dans ce projet.
  ///
  /// Ce compteur ne decrit pas le nombre de taches : il ne recule jamais, meme
  /// si une creation echoue apres reservation. Un trou dans la numerotation est
  /// prefere a la reutilisation d'un identifiant qui a pu circuler dans Git,
  /// dans un log ou dans une conversation.
  nextTaskSequence Int @default(1)

  /// Prochain numero d'entree de memoire a attribuer dans ce projet.
  ///
  /// Meme regle que `nextTaskSequence` : il ne recule jamais. Un `MEM-004`
  /// reattribue apres une suppression designerait deux decisions differentes
  /// dans deux manifests Architecte, et l'historique deviendrait illisible.
  nextMemorySequence Int @default(1)

  /// Conversation Architecte principale du projet, lorsqu'elle a ete ouverte.
  ///
  /// ## Pourquoi un pointeur plutot qu'une recherche par role
  ///
  /// Parce que la garantie « au plus une conversation principale » doit etre
  /// structurelle, et non verifiee a l'ecriture. Une ligne de `Project` ne porte
  /// qu'une valeur : deux ouvertures concurrentes ne peuvent donc pas produire
  /// deux conversations principales, quelle que soit la façon dont elles
  /// s'entrelacent.
  ///
  /// ## Une colonne, pas une relation Prisma
  ///
  /// Meme raison que `Run.parentRunId`, pour une cause differente : declarer la
  /// relation ici creerait un cycle `Project → ArchitectSession → Project`, que
  /// Prisma refuse de resoudre proprement en actions referentielles. L'index
  /// unique reste pose, et il est la garantie qui compte.
  ///
  /// Le pointeur ne peut pas pendre : **aucune session Architecte n'est jamais
  /// supprimee dans NOX**, et une conversation principale n'est ni supprimable,
  /// ni reinitialisable.
  mainArchitectSessionId String?

  /// Prochain numero de generation de backlog a attribuer dans ce projet.
  ///
  /// Meme regle que `nextTaskSequence` : il ne recule jamais, echecs compris.
  /// Un `BACKLOG-002` reattribue designerait deux planifications differentes
  /// dans deux historiques, et la provenance d'une tache deviendrait ambigue.
  nextBacklogSequence Int @default(1)

  /// Generation de backlog en cours, lorsqu'il y en a une.
  ///
  /// C'est le verrou de « un Generate = au plus un appel ». Il est pris par une
  /// mise a jour conditionnelle — `where: { activeBacklogGenerationId: null }` —,
  /// jamais par une lecture suivie d'une ecriture : deux clics simultanes ne
  /// peuvent donc pas tous deux partir. Rendu des que la generation se conclut,
  /// qu'elle ait reussi ou echoue.
  ///
  /// Une colonne plutot qu'une relation Prisma, pour la meme raison que
  /// `mainArchitectSessionId` : la relation creerait un cycle
  /// `Project → ArchitectBacklogGeneration → Project`.
  activeBacklogGenerationId String?

  /// Proposition de backlog en attente de decision, lorsqu'il y en a une.
  ///
  /// ## Pourquoi un pointeur plutot qu'une recherche par statut
  ///
  /// Parce que la garantie « au plus une proposition PENDING par projet » doit
  /// etre structurelle. Une ligne de `Project` ne porte qu'une valeur : deux
  /// generations concurrentes ne peuvent pas produire deux propositions en
  /// attente, quelle que soit la facon dont elles s'entrelacent.
  ///
  /// Deux backlogs a appliquer en meme temps decriraient deux plans concurrents
  /// dont l'un rendrait l'autre perime — et l'utilisateur n'aurait aucun moyen
  /// de savoir lequel.
  ///
  /// Remis a `null` par `Apply` comme par `Dismiss` : une nouvelle planification
  /// redevient alors possible.
  pendingBacklogProposalId String?

  /// La file d'execution du projet est-elle autorisee a demarrer des taches ?
  ///
  /// ## Une autorisation permanente, pas un statut de travail
  ///
  /// `true` veut dire : « un humain a clique sur Start queue, et n'a pas mis en
  /// pause depuis ». C'est ce qui permet a une tache inscrite de partir quand
  /// ses conditions deviennent vraies, sans redemander l'accord a chaque fois.
  ///
  /// Ce n'est **pas** une autorisation de demarrer au boot : NOX ne declenche
  /// rien au lancement du serveur. Une file active attend un evenement
  /// applicatif — une tache terminee, une inscription, un « Try next ».
  ///
  /// Repasse a `false` des que la file se vide, pour qu'une file vide ne laisse
  /// derriere elle aucune autorisation dormante.
  executionQueueActive Boolean @default(false)

  /// Ce que ce projet autorise NOX a ecrire dans Git.
  ///
  /// ## Pourquoi `MANUAL` par defaut, et pourquoi c'est structurel
  ///
  /// Parce qu'une migration ne doit jamais accorder un droit que personne n'a
  /// demande. Un projet cree avant TASK-029 recoit `MANUAL` par la valeur par
  /// defaut de la colonne : le simple fait d'installer cette version produit
  /// zero commit, zero push, zero livraison, zero avancement de file.
  ///
  /// ## Ce que cette colonne autorise, et ce qu'elle n'autorise pas
  ///
  /// Elle est **independante** de `executionQueueActive`. Demarrer une file
  /// autorise NOX a lancer Claude Code et, depuis TASK-028, a repondre a un
  /// echec de validation par un nombre borne de corrections. Elle n'autorise
  /// rien dans Git. Une file active sur un projet `MANUAL` continue de
  /// s'arreter sur un repository modifie, exactement comme avant.
  ///
  /// Valeur de `DeliveryPolicy`. Une valeur illisible est relue comme
  /// `MANUAL` : le defaut sur n'accorde rien.
  deliveryPolicy String @default("MANUAL")

  /// Prochaine position a attribuer dans la file d'execution.
  ///
  /// Meme regle que `nextTaskSequence` : il ne recule jamais. Un `MAX(sequence)`
  /// releve puis incremente donnerait deux fois la meme position a deux
  /// inscriptions simultanees ; une reservation transactionnelle, non.
  nextQueueSequence Int @default(1)

  tasks              Task[]
  architectSessions  ArchitectSession[]
  memories           ProjectMemoryEntry[]
  brief              ProjectBrief?
  v1Plan             ProjectV1Plan?
  projectUpdates     ArchitectProjectUpdate[]
  backlogGenerations ArchitectBacklogGeneration[]
  backlogProposals   ArchitectBacklogProposal[]
  queueEntries       TaskQueueEntry[]
  gitDeliveries      GitDelivery[]

  @@unique([mainArchitectSessionId])
  @@unique([activeBacklogGenerationId])
  @@unique([pendingBacklogProposalId])
}

/// Un appel de planification de backlog, et ce qu'il a rendu.
///
/// ## Pourquoi une table distincte d'`ArchitectGeneration`
///
/// Les deux appellent le meme fournisseur avec la meme configuration, et c'est
/// tout ce qu'ils ont en commun. Une generation conversationnelle appartient a
/// une session et repond a un message ; une planification appartient a un
/// **projet** et repond a un etat. Les coudre dans une seule table aurait
/// impose une colonne `sessionId` nullable dont la moitie des lignes n'auraient
/// rien fait, et un `kind` a verifier partout.
///
/// ## Ce qui n'est pas stocke
///
/// Ni le prompt complet, ni les documents envoyes. `inputHash` identifie
/// l'entree logique sans la conserver ; `contextManifestJson` dit avec quoi le
/// backlog a ete produit. Aucune cle, aucun secret, aucun chemin absolu.
model ArchitectBacklogGeneration {
  id        String @id @default(cuid())
  projectId String

  /// Numero attribue a la creation, unique dans le projet et jamais modifie.
  /// Le code affiche `BACKLOG-001` s'en derive et n'est pas stocke.
  sequence Int

  /// Valeur de `ArchitectBacklogGenerationStatus`.
  status String

  /// Modele effectivement utilise, tel que le serveur l'a lu dans sa configuration.
  model String

  /// Version du prompt de planification, pour qu'un changement soit detectable.
  promptVersion String

  /// Empreinte deterministe de l'entree logique. Diagnostic, jamais securite.
  inputHash String

  /// `BacklogContextManifest` serialise.
  contextManifestJson String

  /// Empreinte du contexte de planification **vu par le fournisseur**.
  ///
  /// Capturee avant l'appel, jamais relue apres : c'est elle qui decide, a
  /// l'application, si la proposition est encore fondee. Elle couvre le brief,
  /// le plan, la memoire active, l'inventaire des taches et les documents
  /// reellement inclus.
  ///
  /// Ce n'est pas une primitive de securite : SHA-256 nu, comme l'empreinte de
  /// contexte de l'Architecte, et contrairement a l'empreinte de dossier de
  /// travail, qui est un HMAC parce qu'elle decide d'une execution.
  planningFingerprint String

  /// Revisions principales, conservees pour l'inspection du manifest.
  ///
  /// L'empreinte ci-dessus suffit a decider de la peremption ; ces colonnes
  /// disent **ce qui** a change quand elle differe. `null` sur le brief ou le
  /// plan signifie « pas encore defini a ce moment-la ».
  baseBriefRevision         String?
  basePlanRevision          String?
  baseTaskInventoryRevision String
  baseMemoryRevision        String

  /// Identifiant de reponse rapporte par le fournisseur, lorsqu'il en fournit un.
  providerResponseId String?

  /// Consommation **rapportee**. Jamais estimee, jamais convertie en cout.
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  cachedInputTokens Int?

  /// Valeur de `ArchitectErrorCode`, lorsque la generation a echoue.
  errorCode String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  project  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposal ArchitectBacklogProposal?

  @@unique([projectId, sequence])
  @@index([projectId, createdAt])
}

/// Un backlog de V1 propose par la planification.
///
/// ## Le payload du fournisseur est immuable
///
/// `providerJson` conserve la reponse telle qu'elle a ete rendue. Aucune
/// ecriture ne le reecrit, y compris quand l'utilisateur modifie, reordonne ou
/// retire des elements avant d'appliquer : ce champ repond a « qu'a propose le
/// modele ? », et cette question a une seule reponse.
///
/// `appliedJson` porte le backlog **reellement retenu par l'humain**, dans son
/// ordre valide. Sans lui, l'historique dirait que le projet a recu exactement
/// ce que le modele avait suggere — ce qui serait faux des la premiere
/// correction.
///
/// ## Pas de statut `STALE`
///
/// La peremption se derive : on reconstruit l'empreinte de planification
/// actuelle et on la compare a celle de la generation. La persister obligerait
/// a la recalculer a chaque changement du projet, et laisserait des
/// propositions marquees perimees alors que l'etat est revenu a ce qu'il etait.
model ArchitectBacklogProposal {
  id           String @id @default(cuid())
  generationId String @unique
  projectId    String

  /// `PENDING`, `APPLIED` ou `DISMISSED`.
  status String

  /// Resume de couverture ecrit pour l'utilisateur. Contenu, jamais instruction.
  message String

  /// Nombre d'elements proposes, pour afficher une liste sans la deserialiser.
  taskCount Int

  /// `ArchitectBacklogProposal` serialise, tel que le fournisseur l'a rendu.
  providerJson String

  /// Backlog applique par l'humain, serialise. `null` tant que ce n'est pas fait.
  appliedJson String?

  appliedAt   DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  /// `Cascade` : une proposition ne raconte rien sans la planification qui l'a produite.
  generation ArchitectBacklogGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  project    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Taches creees par l'application de ce backlog.
  ///
  /// C'est la seule reponse a « quelle proposition a cree TASK-014 ? », et elle
  /// vit dans le schema plutot que dans un texte d'interface.
  tasks Task[]

  @@index([projectId, createdAt])
}

/// Brief produit du projet : ce qu'on construit, pour qui, contre quel probleme.
///
/// ## Une table, pas des colonnes sur `Project`
///
/// Le brief a son propre cycle de vie, ses propres bornes et sa propre revision.
/// Le coudre dans `Project` aurait ajoute six colonnes a une table lue partout,
/// dont la plupart des lecteurs n'ont que faire.
///
/// ## Absent veut dire « pas encore defini »
///
/// Aucune ligne tant que personne n'a rien ecrit — c'est l'etat de depart de
/// tout projet, et il est valide. Une fois creee, la ligne reste : vider ses
/// champs est une edition, pas une suppression. Faire disparaitre la ligne
/// ferait osciller le contexte entre « absent » et « present » a chaque coup de
/// gomme, et le diff de contexte annoncerait des ajouts et des retraits la ou il
/// n'y a qu'une modification.
model ProjectBrief {
  id        String @id @default(cuid())
  projectId String @unique

  summary        String
  problem        String
  targetUsers    String
  desiredOutcome String

  /// Listes ordonnees, serialisees. L'ordre est significatif : il entre dans la
  /// revision, parce que deux objectifs intervertis ne se lisent pas pareil.
  goalsJson    String
  nonGoalsJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Cascade` : un brief ne decrit rien sans son projet.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Plan de V1 du projet : ce que la premiere version utile doit accomplir.
///
/// Les etapes decrivent des **capacites atteintes**, jamais des travaux a faire.
/// Ni code de tache, ni critere d'acceptation, ni commande de validation, ni
/// dependance : ce plan reste au-dessus du backlog, et TASK-022 fera la
/// traduction.
model ProjectV1Plan {
  id        String @id @default(cuid())
  projectId String @unique

  goal               String
  technicalDirection String

  /// Listes ordonnees, serialisees.
  inScopeJson    String
  outOfScopeJson String
  milestonesJson String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Mise a jour du projet proposee par l'Architecte lors d'un tour.
///
/// ## Une proposition, jamais une ecriture
///
/// Le fournisseur peut proposer un nouvel etat du brief et du plan. Il ne
/// l'applique pas : seule une action humaine explicite le fait, et elle passe
/// par la meme validation que l'edition manuelle. Le Structured Output ne donne
/// aucune autorite — bornes, sanitation et budget sont revalides a l'application.
///
/// ## Le payload du fournisseur est immuable
///
/// `proposedJson` conserve ce que le modele a reellement rendu, tel quel.
/// L'utilisateur peut modifier la proposition avant de l'appliquer ; sa version
/// vit dans le formulaire, puis directement dans le brief et le plan. Ecraser le
/// payload d'origine ferait perdre la reponse historique du modele.
model ArchitectProjectUpdate {
  id           String @id @default(cuid())
  generationId String @unique
  projectId    String

  /// `PENDING`, `APPLIED` ou `DISMISSED`.
  status String

  /// Pourquoi le modele propose ce changement. Contenu, jamais instruction.
  reason String

  /// `ArchitectProjectUpdateProposal` serialise, tel que le fournisseur l'a rendu.
  ///
  /// **Immuable.** Aucune ecriture ne le reecrit, y compris quand l'utilisateur
  /// modifie la proposition avant de l'appliquer : ce champ repond a « qu'a
  /// repondu le modele ? », et cette question a une seule reponse.
  proposedJson String

  /// `ProjectUpdateTarget` serialise : ce que l'utilisateur a reellement applique.
  ///
  /// `null` tant que la proposition n'est pas `APPLIED`. Sans cette colonne, une
  /// proposition modifiee avant application ne laisserait aucune trace de ce qui
  /// a ete retenu — l'historique dirait ce que le modele avait suggere, jamais ce
  /// que le projet a recu. Les deux artefacts sont ensuite figes : modifier le
  /// plan a la main plus tard n'en change aucun.
  appliedJson String?

  /// Revisions du brief et du plan au moment de la proposition.
  ///
  /// `null` signifie « pas encore defini a ce moment-la ». Elles sont comparees
  /// a l'application : une proposition batie sur un plan que l'utilisateur a
  /// modifie depuis est refusee, jamais fusionnee en silence.
  baseBriefRevision String?
  basePlanRevision  String?

  appliedAt   DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  /// `Cascade` comme les messages : une proposition ne raconte rien sans son tour.
  generation ArchitectGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Une entree de memoire projet : ce que NOX retient volontairement.
///
/// ## Pourquoi cette table existe
///
/// L'Architecte recoit des documents entiers et les dix dernieres taches. Une
/// decision precise y est noyee, et depend de la capacite du modele a la
/// retrouver. Une entree de memoire dit ce qui compte, et seulement cela.
///
/// ## Ce qui n'y entre jamais
///
/// Rien d'automatique. Ni une proposition d'architecte, ni une observation de
/// review, ni un compte rendu de Claude Code, ni un extrait de conversation. Une
/// hesitation exprimee dans une discussion n'est pas une decision, et NOX ne
/// transforme jamais l'une en l'autre.
///
/// ## Le texte stocke est celui de l'utilisateur
///
/// La sanitation s'applique **a l'envoi**, pas a l'ecriture : ce qui est relu
/// six mois plus tard doit etre le texte ecrit, pas sa version masquee. La
/// revision transmise a l'architecte, elle, decrit le texte sanitise — c'est
/// celui que le fournisseur a reellement recu.
model ProjectMemoryEntry {
  id        String @id @default(cuid())
  projectId String

  /// Numero attribue a la creation, unique dans le projet et jamais modifie.
  sequence Int

  /// Valeur de `ProjectMemoryCategory`, stockee en chaine comme les autres enums.
  category String

  title     String
  content   String
  rationale String?

  /// Valeur de `ProjectMemoryStatus` : `ACTIVE` ou `ARCHIVED`.
  ///
  /// `ACTIVE` signifie « envoye a l'Architecte », `ARCHIVED` « conserve mais
  /// non envoye ». Il n'existe pas de troisieme etat : une entree active que le
  /// budget ecarterait silencieusement ferait mentir l'interface.
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `Cascade` : une memoire ne decrit rien sans son projet.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequence])
  @@index([projectId, status])
}

/// Une tache de developpement : la specification d'une unite de travail.
///
/// Le code affiche (`TASK-001`) n'est pas stocke : il se derive de `sequence`,
/// qui est immuable. Deux representations d'une meme verite finissent toujours
/// par diverger ; une seule ne le peut pas.
///
/// `status`, `priority` et `documentSyncStatus` sont des chaines : SQLite ne
/// connait pas les enums, et ces listes sont deja definies une seule fois dans
/// `@nox/shared`. La validation est faite a la relecture, par la couche
/// applicative.
model Task {
  id        String @id @default(cuid())
  projectId String

  /// Numero attribue a la creation, unique dans le projet et jamais modifie.
  ///
  /// `0` est reserve a la tache d'amorcage : `Project.nextTaskSequence` demarre
  /// a `1` et ne recule jamais, donc aucune attribution ordinaire ne peut le
  /// produire. L'unicite de `TASK-000` est ainsi portee par
  /// `@@unique([projectId, sequence])`, sans verrou applicatif ni index de plus.
  sequence Int

  /// Nature de la tache : `NORMAL` ou `BOOTSTRAP`.
  ///
  /// Declaree, jamais deduite du code. `sequence === 0` suffirait aujourd'hui et
  /// cesserait de suffire des qu'une regle porterait sur la nature plutot que
  /// sur le numero : une convention d'affichage ne doit pas porter de semantique.
  ///
  /// Deux valeurs, et il n'en faut pas plus. Un systeme generique de types de
  /// taches serait une abstraction sans deuxieme usage.
  kind String @default("NORMAL")

  title      String
  objective  String
  context    String?
  outOfScope String?

  status   String
  priority String

  /// Chemin relatif du Markdown associe : `tasks/TASK-001.md`.
  documentPath String

  /// Empreinte du document, connue seulement lorsqu'il est synchronise.
  documentRevision String?

  documentSyncStatus String
  documentSyncError  String?

  /// Prochain numero d'execution a attribuer pour cette tache.
  ///
  /// Meme regle que `Project.nextTaskSequence` : il ne recule jamais, et un
  /// trou vaut mieux qu'un `RUN-002` qui designerait deux executions.
  nextRunSequence Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  acceptanceCriteria TaskAcceptanceCriterion[]
  documentReferences TaskDocumentReference[]
  validationCommands TaskValidationCommand[]
  runs               Run[]
  reviewFeedbacks    ReviewFeedback[]

  /// Session historique qui a cree cette tache, le cas echeant.
  architectSession ArchitectSession?

  /// Generation d'une conversation projet qui a cree cette tache, le cas echeant.
  ///
  /// Les deux sont exclusives en pratique — une tache vient d'un modele ou de
  /// l'autre — mais rien ne l'impose au niveau du schema : deux liens vides sont
  /// le cas normal, celui d'une tache ecrite a la main.
  architectGeneration ArchitectGeneration? @relation("TaskFromGeneration")

  /// Proposition de backlog qui a cree cette tache, le cas echeant.
  ///
  /// ## Pourquoi deux colonnes plutot qu'une table de liaison
  ///
  /// Une tache vient d'au plus un backlog, et occupe une seule position dans
  /// lui. Une table de liaison aurait modelise une relation plusieurs-a-plusieurs
  /// qui n'existe pas, et aurait rendu possible un etat — deux origines pour une
  /// tache — que rien ne devrait pouvoir produire.
  ///
  /// `Restrict` comme les autres liens de provenance : une tache creee depuis un
  /// backlog n'est pas supprimable tant que ce backlog la designe. Retracer d'ou
  /// vient une tache vaut mieux qu'une suppression silencieuse.
  backlogProposalId String?

  /// Position de cette tache dans l'ordre **valide par l'humain**, a partir de 0.
  ///
  /// L'ordre affiche apres application est celui-la, jamais celui du fournisseur :
  /// si l'utilisateur a deplace une tache avant d'appliquer, c'est son ordre qui
  /// fait foi. `null` pour toute tache qui ne vient pas d'un backlog.
  backlogItemPosition Int?

  backlogProposal ArchitectBacklogProposal? @relation(fields: [backlogProposalId], references: [id], onDelete: Restrict)

  /// Dependances sortantes : les taches que celle-ci attend.
  dependencies TaskDependency[] @relation("TaskDependencyFrom")

  /// Dependances entrantes : les taches qui attendent celle-ci.
  dependents TaskDependency[] @relation("TaskDependencyTo")

  /// Inscription dans la file d'execution du projet, le cas echeant.
  queueEntry TaskQueueEntry?

  /// Corrections reservees sur cette tache, lancees ou non.
  correctionAttempts CorrectionAttempt[]

  /// Livraisons Git reservees pour cette tache.
  gitDeliveries GitDelivery[]

  @@unique([projectId, sequence])
  @@index([projectId, status])
  @@index([backlogProposalId, backlogItemPosition])
}

/// Une execution : un passage de Claude Code sur une tache.
///
/// Le prompt est conserve **exactement** tel qu'il a ete envoye, avec son
/// empreinte. C'est ce qui rend une execution relisible des mois plus tard :
/// la specification de la tache aura pu evoluer, le prompt reellement envoye,
/// non.
///
/// Les champs Claude et Git sont facultatifs : ils n'existent qu'une fois le
/// processus termine, et certains ne sont pas garantis par toutes les versions
/// de Claude Code. Aucune valeur n'est inventee pour combler un manque.
model Run {
  id     String @id @default(cuid())
  taskId String

  /// Numero attribue a la creation, unique dans la tache et jamais modifie.
  sequence Int

  status String

  /// Valeur de `RunKind` : `INITIAL` ou `CORRECTION`.
  ///
  /// Une correction n'est pas une execution un peu differente : c'est une
  /// execution qui part d'un dossier de travail volontairement sale, celui-la
  /// meme qui vient d'etre relu. La distinguer explicitement evite qu'un futur
  /// changement de preflight ne s'applique par erreur aux deux.
  kind String @default("INITIAL")

  /// Execution relue dont cette correction reprend la session.
  ///
  /// `null` pour un run initial. `Restrict` en cascade : le parent est un fait
  /// historique, et une correction qui le referencerait dans le vide raconterait
  /// une reprise dont on aurait perdu le point de depart.
  parentRunId String?

  /// Session Claude **demandee** au lancement d'une correction.
  ///
  /// Distincte de `claudeSessionId`, qui porte celle que l'execution a
  /// **rapportee**. Les deux coincident en pratique — le binaire conserve
  /// l'identifiant a la reprise —, mais les confondre reviendrait a supposer un
  /// comportement plutot qu'a l'enregistrer.
  resumedFromSessionId String?

  prompt       String
  promptSha256 String

  /// Identifiant transmis au runner ; cle de son registre en memoire.
  runnerRunId String

  claudeSessionId String?
  resultText      String?
  stderrTail      String?

  exitCode     Int?
  errorCode    String?
  errorMessage String?

  durationMs      Int?
  durationApiMs   Int?
  numTurns        Int?
  /// Cout rapporte par Claude Code. Jamais calcule ni estime par NOX.
  reportedCostUsd Float?

  gitBranch     String?
  gitUpstream   String?
  gitHeadBefore String?
  gitHeadAfter  String?
  gitDiffStat   String?
  /// Chemins relatifs des fichiers modifies, un par ligne.
  changedFiles  String?

  startedAt  DateTime?
  finishedAt DateTime?

  /// Date a laquelle un humain a demande l'arret de cette execution.
  ///
  /// Le seul des trois champs proposes par TASK-010 qui ait ete retenu. Il
  /// enregistre un fait qu'aucune autre colonne ne porte : quelqu'un a decide
  /// d'interrompre, et cette decision doit survivre a un redemarrage du runner.
  ///
  /// `cancelledAt` n'existe pas : `finishedAt` avec `status = CANCELLED` dit
  /// exactement la meme chose. `lastEventSequence` non plus : il se derive du
  /// `MAX(sequence)` des `RunEvent`, et un compteur denormalise finirait par
  /// diverger des lignes qu'il pretend compter — l'inverse de l'idempotence
  /// recherchee.
  cancellationRequestedAt DateTime?

  /// Moment ou l'instantane de review a ete enregistre.
  ///
  /// Non nul signifie « la capture a eu lieu », y compris lorsqu'elle n'a trouve
  /// aucun changement. Une review vide et une review absente sont deux choses
  /// differentes : la premiere dit « l'agent n'a rien modifie », la seconde dit
  /// « NOX ne sait pas ». Les confondre inventerait une precision qui n'existe
  /// pas, et c'est exactement ce qui distingue un run d'avant TASK-011 d'un run
  /// sans changement.
  reviewCapturedAt DateTime?

  /// Code d'erreur de la capture detaillee, lorsqu'elle a echoue.
  ///
  /// Distinct de `errorCode` : celui-ci porte l'echec de l'execution, celui-la
  /// l'echec de sa relecture. Un diff que NOX n'a pas su capturer ne transforme
  /// jamais un succes de Claude Code en echec.
  reviewErrorCode String?

  /// Fichiers changes mais non decrits, faute de place.
  ///
  /// Le seul compteur stocke de la review, parce qu'il est le seul a ne pas etre
  /// derivable : les lignes absentes ne peuvent pas se compter elles-memes. Tout
  /// le reste — additions, suppressions, fichiers sensibles, patches tronques —
  /// se calcule a partir des `RunFileChange`.
  reviewOmittedFiles Int @default(0)

  /// Prochain numero d'analyse Architecte a attribuer pour cette execution.
  ///
  /// Meme regle que les autres compteurs de NOX : il ne recule jamais, y compris
  /// apres une analyse en echec. Celle-ci a consomme un appel facture, et son
  /// numero ne doit pas etre reattribue. C'est aussi lui qui borne le nombre
  /// d'analyses d'une execution.
  nextArchitectReviewSequence Int @default(1)

  /// Empreinte opaque du dossier de travail a la fin de l'execution.
  ///
  /// Un HMAC hexadecimal, dont la cle est derivee du jeton du runner et n'est
  /// jamais stockee ici. Elle n'est **jamais** rendue au navigateur : elle ne sert
  /// qu'a repondre a une question, cote serveur — « le dossier de travail est-il
  /// encore exactement celui qui a ete relu ? ».
  ///
  /// `null` pour toute execution anterieure a TASK-012, qui n'est donc pas
  /// reprenable. C'est voulu : une empreinte reconstituee apres coup decrirait le
  /// present en pretendant decrire le passe.
  workspaceFingerprint String?

  /// Version de l'algorithme d'empreinte, pour qu'un changement soit detectable.
  workspaceFingerprintVersion String?

  /// Code d'erreur du calcul d'empreinte, lorsqu'il a echoue.
  ///
  /// Distinct de `reviewErrorCode` : une review peut parfaitement aboutir alors
  /// que l'empreinte a bute sur une borne. La premiere sert a lire, la seconde a
  /// autoriser une reprise.
  workspaceFingerprintErrorCode String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// `Restrict` et non `Cascade`, contrairement aux trois tables enfant de
  /// `Task` : un critere d'acceptation n'a aucun sens sans sa tache, alors qu'une
  /// execution est un fait historique. Elle a consomme du quota, modifie un
  /// repository et produit un compte rendu ; la faire disparaitre parce que la
  /// tache disparait effacerait la trace de ce qui s'est reellement passe.
  ///
  /// Cette contrainte double la regle metier de `deleteTaskWithoutRuns`. Ce
  /// n'est pas une redondance : la regle metier produit un message utile, la
  /// contrainte tient meme si quelqu'un l'ignore et appelle Prisma directement.
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  events           RunEvent[]
  fileChanges      RunFileChange[]
  validations      RunValidationResult[]
  architectReviews ArchitectRunReview[]

  autonomousBatches AutonomousValidationBatch[]
  reviewDecision    RunReviewDecision?

  feedbacks          ReviewFeedback[] @relation("ReviewFeedbackSource")
  triggeringFeedback ReviewFeedback?  @relation("ReviewFeedbackCorrection")

  /// Corrections reservees **depuis** cette execution.
  correctionAttempts CorrectionAttempt[] @relation("CorrectionAttemptSource")

  /// Reservation dont cette execution est nee, pour une correction.
  correctionAttempt CorrectionAttempt? @relation("CorrectionAttemptRun")

  /// Livraisons Git dont cette execution est le travail valide.
  gitDeliveries GitDelivery[]

  /// `parentRunId` est une colonne, pas une relation Prisma.
  ///
  /// L'index unique est la garantie qui compte : il interdit qu'une meme
  /// execution recoive deux corrections, y compris sur double clic concurrent.
  /// La cle etrangere, elle, n'est pas declaree — `ALTER TABLE ADD COLUMN` ne
  /// sait pas en creer sous SQLite, et la seule alternative aurait ete de
  /// reconstruire une table qui porte l'historique reel des executions.
  ///
  /// Elle ne protegerait de toute facon contre rien d'atteignable : **aucune
  /// execution n'est jamais supprimee dans NOX**, donc aucun parent ne peut
  /// disparaitre. Le schema decrit ici exactement ce que la base contient, plutot
  /// que d'annoncer une contrainte qui n'existe pas.
  @@unique([taskId, sequence])
  @@unique([parentRunId])
  @@index([taskId, status])
}

/// Le texte par lequel un humain demande une correction apres une review.
///
/// ## Pourquoi il est persiste
///
/// Parce qu'il fait partie de l'histoire de la tache au meme titre que le prompt
/// et le diff. Six mois plus tard, « pourquoi RUN-002 existe-t-il ? » n'a qu'une
/// bonne reponse : le texte exact que l'utilisateur avait ecrit. Le regenerer ou
/// le resumer le rendrait faux.
///
/// ## Pourquoi il est immuable une fois utilise
///
/// Un feedback vaut pour **une** correction. Le modifier apres coup ferait mentir
/// le prompt deja envoye ; le reutiliser lancerait deux reprises de la meme
/// session avec le meme texte, ce qu'un double clic suffirait a provoquer.
/// `correctionRunId` est donc unique, et sa pose est la prise du verrou.
model ReviewFeedback {
  id     String @id @default(cuid())
  taskId String

  /// Execution relue au moment ou le feedback a ete ecrit.
  sourceRunId String

  /// Texte exact, normalise en fins de ligne `\n` et borne.
  text String

  /// Correction lancee depuis ce feedback, une fois seulement.
  correctionRunId String?

  createdAt DateTime  @default(now())
  usedAt    DateTime?

  /// `Restrict` comme `Run` → `Task` : un feedback est un fait historique, et il
  /// documente une execution que rien ne supprime.
  task          Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceRun     Run  @relation("ReviewFeedbackSource", fields: [sourceRunId], references: [id], onDelete: Restrict)
  correctionRun Run? @relation("ReviewFeedbackCorrection", fields: [correctionRunId], references: [id], onDelete: Restrict)

  @@unique([correctionRunId])
  @@index([taskId, createdAt])
  @@index([sourceRunId])
}

/// Un fichier change par une execution, tel qu'il l'etait a la fin de celle-ci.
///
/// ## Un instantane, pas une vue
///
/// Ces lignes sont ecrites **une fois**, au moment ou l'execution devient
/// finale, et ne sont plus jamais recalculees. C'est toute la difference entre
/// une review et un `git diff` : le second raconte le present du disque, la
/// premiere raconte ce que l'agent avait produit. Si l'utilisateur edite un
/// fichier apres coup — ce qui est exactement ce qu'on attend de lui —, la
/// review historique doit continuer de dire la verite sur le passe.
///
/// ## Ce qui n'entre jamais ici
///
/// Aucun blob binaire : pour un fichier binaire, `patch` vaut `null` et
/// `isBinary` porte l'information. Aucun contenu de fichier sensible : un `.env`
/// apparait par son chemin et ses statistiques, jamais par son texte. Aucun
/// fichier entier hors d'un patch borne : au-dela des limites de `REVIEW_LIMITS`,
/// `isTruncated` le dit explicitement plutot que de couper en silence.
///
/// `path` est **toujours** relatif au repository, separateurs `/`. Un chemin
/// absolu est refuse par le contrat partage avant d'arriver jusqu'ici.
model RunFileChange {
  id    String @id @default(cuid())
  runId String

  /// Rang stable dans la review, attribue a la capture.
  ///
  /// L'ordre n'est pas cosmetique : c'est lui qui rend deux affichages de la
  /// meme review identiques, et une navigation par `?file=` reproductible.
  position Int

  path String
  /// Renseigne uniquement pour un renommage ou une copie.
  previousPath String?

  /// Valeur de `RunChangeType`, stockee en chaine comme les autres enums.
  changeType String

  /// Comptes rapportes par Git ; `null` lorsqu'il n'en fournit pas (binaire).
  additions Int?
  deletions Int?

  isBinary    Boolean @default(false)
  isSensitive Boolean @default(false)
  isTruncated Boolean @default(false)

  /// Diff unifie, ou `null` : binaire, sensible, ou au-dela des bornes.
  patch String?

  createdAt DateTime @default(now())

  /// `Cascade`, comme `RunEvent` : un changement de fichier ne raconte rien sans
  /// son execution, et rien d'autre ne le referencera jamais.
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId, position])
}

/// Une commande de validation attendue par la tache, et ce qu'elle est devenue.
///
/// ## Pourquoi la commande est recopiee
///
/// Le texte de la commande est **copie** depuis la tache a la creation de
/// l'execution, jamais simplement reference. Une specification evolue ; la review
/// d'une execution passee, non. Sans cette copie, corriger `npm run test` en
/// `npm test` dans la tache reecrirait l'histoire de tous les runs precedents.
///
/// ## Ce que le statut represente
///
/// Uniquement ce que Claude Code a **reellement** execute pendant le run. NOX ne
/// relance aucune commande pour completer le tableau : une commande `NOT_RUN`
/// est une information, pas un trou a combler.
model RunValidationResult {
  id    String @id @default(cuid())
  runId String

  /// Rang dans la tache, recopie a la creation de l'execution.
  position Int

  /// Texte exact, tel qu'il etait au lancement.
  command String

  /// Valeur de `RunValidationStatus`, stockee en chaine.
  status String

  /// Code de sortie **rapporte** par l'outil ; jamais deduit ni invente.
  exitCode Int?
  /// Resume borne et nettoye de la sortie, lorsqu'il y en a un.
  summary  String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId, position])
}

/// Un evenement public d'une execution, tel qu'il a ete affiche.
///
/// ## Ce qui est stocke ici a deja ete nettoye
///
/// Les lignes brutes de Claude Code n'atteignent jamais cette table. Ce qui y
/// arrive a traverse le normaliseur puis le nettoyeur du runner : chemins rendus
/// relatifs, secrets retires, raisonnement interne ecarte, tailles bornees. La
/// base n'est pas une seconde barriere de securite — elle est *derriere* la
/// barriere, et c'est pour cela qu'aucune sanitation n'est refaite a la lecture.
///
/// ## Pourquoi persister ce que le registre possede deja
///
/// Le registre du runner est en memoire : un redemarrage l'efface. Sans cette
/// table, rouvrir la page d'une execution passee n'afficherait plus rien de ce
/// qui s'est passe pendant qu'elle tournait. Les evenements sont la mémoire
/// longue ; le registre n'est que la fenetre du direct.
///
/// `runId + sequence` est unique : c'est ce couple qui rend la persistance
/// idempotente. Le flux SSE peut renvoyer deux fois le meme evenement — deux
/// onglets, une reconnexion — sans jamais creer de doublon.
model RunEvent {
  id    String @id @default(cuid())
  runId String

  /// Numero attribue par le runner, strictement croissant dans l'execution.
  sequence Int

  /// Valeur de `ClaudeRunEventKind`, stockee en chaine comme les autres enums.
  kind String

  label   String
  detail  String?
  toolName String?
  isError Boolean @default(false)

  /// Date produite par le runner, jamais reprise de Claude Code.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  /// `Cascade`, contrairement a la relation `Run` → `Task`.
  ///
  /// Un evenement n'a aucun sens sans son execution : il ne raconte rien tout
  /// seul, et rien ne le referencera jamais. La regle qui protege l'historique
  /// porte sur les executions elles-memes — et la suppression d'une execution
  /// n'existe nulle part dans NOX.
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

/// Un critere d'acceptation, a la position ou l'utilisateur l'a saisi.
///
/// Aucune case « terminee » : cette table decrit ce qui devra etre vrai a la
/// fin, pas ce qui l'est deja. Le resultat d'une execution appartiendra a un
/// autre modele, quand NOX saura lancer Claude Code.
/// Un critere d'acceptation, et la facon dont il se verifie.
///
/// ## Pourquoi le mode vit ici
///
/// Parce que la classification appartient au **contrat**, pas au resultat.
/// Decider apres l'execution qu'un critere etait automatisable produirait une
/// classification qui s'adapte a ce qui est passe — donc qui ne prouve rien.
///
/// Le defaut est `HUMAN`, et c'est le defaut sur : une tache historique migree
/// ne gagne jamais, en silence, le droit de se terminer toute seule.
model TaskAcceptanceCriterion {
  id        String   @id @default(cuid())
  taskId    String
  position  Int
  text      String
  createdAt DateTime @default(now())

  /// Valeur de `VerificationMode` : `AUTOMATED` ou `HUMAN`.
  verificationMode String @default("HUMAN")

  /// Ce que le testeur doit faire, pour un critere humain.
  ///
  /// Nullable, et pas seulement par commodite de migration : une tache
  /// `DRAFT` a le droit d'etre incomplete, et c'est `Mark ready` qui exige
  /// cette instruction. Remplir les lignes historiques d'un texte generique
  /// aurait invente une consigne que personne n'a ecrite.
  humanInstructions String?

  task  Task                      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  proofs TaskCriterionValidation[]

  @@unique([taskId, position])
}

/// Quelle commande prouve quel critere.
///
/// ## Pourquoi une table
///
/// Parce que la relation est un vrai plusieurs-a-plusieurs : `npm test` et
/// `npm run typecheck` peuvent prouver ensemble un seul critere, et `npm test`
/// peut en prouver trois. Forcer un critere a n'avoir qu'une commande aurait
/// fait dupliquer des criteres pour contourner le modele.
///
/// ## Pourquoi des identifiants
///
/// Parce qu'une liste d'indices dans une chaine se decale au premier
/// reordonnancement, et qu'un lien par texte de commande se casse a la premiere
/// correction d'orthographe. `Cascade` des deux cotes : le lien ne decrit rien
/// sans ses deux extremites.
model TaskCriterionValidation {
  id          String @id @default(cuid())
  criterionId String
  commandId   String

  createdAt DateTime @default(now())

  criterion TaskAcceptanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  command   TaskValidationCommand   @relation(fields: [commandId], references: [id], onDelete: Cascade)

  /// Un lien au plus entre un critere et une commande : le declarer deux fois
  /// est un double-clic, pas une double preuve.
  @@unique([criterionId, commandId])
  @@index([commandId])
}

/// Un document que l'agent devra lire avant d'implementer la tache.
///
/// Le chemin est relatif au repository et n'est pas verifie sur le disque : une
/// tache peut legitimement referencer un fichier qui sera cree avant son
/// execution.
model TaskDocumentReference {
  id        String   @id @default(cuid())
  taskId    String
  position  Int
  path      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}

/// Une commande de validation declaree par la tache.
///
/// Elle est stockee comme du texte et n'est **jamais** executee : NOX ne sait
/// pas encore lancer de processus depuis une tache, et rien ici n'ouvre ce
/// droit.
/// Une commande de validation enregistree sur une tache.
///
/// `executionMode` dit ce que **NOX** a le droit d'en faire. Le defaut,
/// `AGENT_ONLY`, est exactement le comportement d'avant TASK-027 : la commande
/// est autorisee a Claude Code, et NOX ne la lance jamais lui-meme. Aucune
/// commande historique ne devient donc executable sans surveillance du seul
/// fait d'une migration — `npm run dev` en est la raison la plus evidente.
model TaskValidationCommand {
  id        String   @id @default(cuid())
  taskId    String
  position  Int
  command   String
  createdAt DateTime @default(now())

  /// Valeur de `CommandExecutionMode` : `AGENT_ONLY` ou `AUTONOMOUS`.
  executionMode String @default("AGENT_ONLY")

  task   Task                      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  proofs TaskCriterionValidation[]

  @@unique([taskId, position])
}

/// Une analyse de review par l'Architecte, et ce qu'elle a rendu.
///
/// ## Pourquoi un enfant de `Run`, et pas une colonne
///
/// Parce qu'une execution peut legitimement etre relue plusieurs fois : un
/// modele different, un prompt ameliore, une seconde lecture demandee. Ecraser
/// la precedente effacerait ce qui avait ete dit, alors que c'est precisement ce
/// qu'on veut comparer.
///
/// Chaque analyse terminee est **immuable** : la couche d'ecriture refuse de
/// modifier une ligne qui n'est plus `RUNNING`.
///
/// ## Deux verdicts, et pourquoi les deux
///
/// `providerVerdict` est ce que le modele a propose ; `finalVerdict` ce que NOX
/// retient apres sa garde. Les confondre reecrirait l'histoire : six mois plus
/// tard, on ne saurait plus si l'architecte s'etait trompe ou si NOX l'avait
/// corrige parce qu'une partie de la review lui etait invisible.
///
/// ## Ce qui n'est pas stocke
///
/// Ni le prompt, ni les patches, ni le bundle. Les patches existent deja dans
/// `RunFileChange` ; `manifestJson` dit **combien** en est parti et si le bundle
/// etait complet, `inputHash` identifie l'entree logique sans la conserver.
model ArchitectRunReview {
  id    String @id @default(cuid())
  runId String

  /// Numero attribue a la creation, unique dans l'execution et jamais modifie.
  sequence Int

  /// Modele effectivement utilise, tel que le serveur l'a lu dans sa configuration.
  model String

  /// Version du prompt de review, pour qu'un changement de consignes soit detectable.
  promptVersion String

  /// Empreinte deterministe de l'entree logique. Diagnostic, jamais securite.
  inputHash String

  /// `ArchitectReviewManifest` serialise.
  manifestJson String

  /// Valeur de `ArchitectReviewStatus`.
  status String

  /// Valeur de `ArchitectReviewVerdict` rendue par le modele.
  providerVerdict String?

  /// Valeur de `ArchitectReviewVerdict` retenue par NOX apres sa garde.
  finalVerdict String?

  /// Faits qui interdisaient une recommandation d'approbation, serialises.
  blockersJson String?

  summary String?

  /// `ArchitectReviewFinding[]` serialise.
  findingsJson String?

  /// Feedback suggere, tel que le modele l'a rendu.
  ///
  /// Il n'est jamais transmis a Claude Code depuis ici : l'utilisateur le relit,
  /// le modifie et le valide, et c'est alors un `ReviewFeedback` ordinaire qui
  /// est cree par le workflow de TASK-012.
  feedback String?

  /// Identifiant de reponse rapporte par le fournisseur, lorsqu'il en fournit un.
  providerResponseId String?

  /// Consommation **rapportee**. Jamais estimee, jamais convertie en cout.
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  cachedInputTokens Int?

  /// Valeur de `ArchitectErrorCode`, lorsque l'analyse a echoue.
  errorCode String?

  createdAt DateTime @default(now())

  /// `Cascade` comme `RunFileChange` : une analyse ne raconte rien sans son
  /// execution, et rien d'autre ne la referencera jamais. La regle qui protege
  /// l'historique porte sur les executions, dont aucune n'est jamais supprimee.
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

/// Une conversation bornee avec l'Architecte, autour d'une demande produit.
///
/// ## Pourquoi une session, et pas seulement une generation
///
/// Parce qu'une proposition se construit rarement du premier coup : l'architecte
/// pose des questions, l'utilisateur repond, une seconde generation arrive. La
/// session porte ce qui traverse ces tours — la demande, les precisions, l'issue
/// — pendant que chaque generation garde ce qui lui est propre.
///
/// ## Ce qu'elle ne contient pas
///
/// Aucun document du repository. Le contexte envoye est decrit par le manifest de
/// chaque generation, jamais recopie : dupliquer des dizaines de kilooctets de
/// Markdown a chaque appel ferait de SQLite une seconde copie de Git, et une copie
/// qui vieillit mal.
///
/// `appliedTaskId` est unique : une session cree **une** tache, jamais deux, y
/// compris sur double clic concurrent. La garantie vit dans l'index, pas dans la
/// discipline de l'appelant.
model ArchitectSession {
  id        String @id @default(cuid())
  projectId String

  /// Numero attribue a la creation, unique dans le projet et jamais modifie.
  sequence Int

  /// Demande produit, telle que l'utilisateur l'a ecrite.
  requestText String

  /// Precisions apportees en reponse aux questions de l'architecte.
  ///
  /// Champ de TASK-013, conserve pour relire les sessions d'alors. Depuis
  /// TASK-014, les precisions sont des messages de conversation : ce champ
  /// n'est plus jamais ecrit.
  clarificationText String?

  /// Version conversationnelle : 1 avant TASK-014, 2 ensuite.
  ///
  /// Une session `1` n'a jamais enregistre de messages. NOX ne lui en invente
  /// pas : elle reste consultable avec ses generations et sa tache, mais ne se
  /// poursuit plus. Une fausse reconstruction serait pire qu'une lecture seule.
  conversationVersion Int @default(1)

  /// Valeur de `ArchitectSessionKind`.
  ///
  /// `TASK_DESIGN_LEGACY` par defaut, ce qui decrit exactement les sessions
  /// existantes : elles ont ete ouvertes pour concevoir une tache, et se sont
  /// fermees en la creant. La valeur par defaut n'est donc pas un repli, c'est
  /// la verite historique.
  ///
  /// `PROJECT` designe la conversation principale d'un projet. Elle ne devient
  /// jamais `APPLIED`, et `appliedTaskId` y reste toujours `null` : ses taches
  /// sont portees par les generations qui les ont produites.
  kind String @default("TASK_DESIGN_LEGACY")

  /// Texte du prochain message, prepare mais pas encore envoye.
  ///
  /// Le brouillon vit ici plutot que dans le navigateur pour une raison simple :
  /// l'apercu et l'envoi doivent parler du **meme** message. Il est efface dans
  /// la transaction qui fige le tour, ce qui empeche un rafraichissement de
  /// reemettre l'appel.
  pendingMessageText String?

  /// Empreinte du contexte au moment de l'apercu.
  pendingContextFingerprint String?

  /// `ArchitectContextManifest` de l'apercu, serialise.
  pendingContextManifestJson String?

  pendingPreparedAt DateTime?

  /// Valeur de `ArchitectSessionStatus`, stockee en chaine comme les autres enums.
  status String

  /// Prochain numero de generation, incremente de facon atomique.
  ///
  /// Il ne recule jamais, meme apres un echec : une generation ratee a consomme
  /// un appel et un quota, et son numero ne doit pas etre reattribue. C'est aussi
  /// lui qui borne le nombre d'appels d'une session.
  nextGenerationSequence Int @default(1)

  /// Tache creee depuis cette session, une fois seulement.
  ///
  /// Champ du modele `TASK_DESIGN_LEGACY`, ou une session valait une tache.
  /// Une session `PROJECT` ne l'ecrit jamais : elle peut produire plusieurs
  /// taches au fil du temps, chacune rattachee a la generation qui l'a proposee.
  appliedTaskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appliedTask Task?                 @relation(fields: [appliedTaskId], references: [id], onDelete: Restrict)
  generations ArchitectGeneration[]
  messages    ArchitectMessage[]

  @@unique([projectId, sequence])
  @@unique([appliedTaskId])
  @@index([projectId, createdAt])
}

/// Un message de la conversation Architecte.
///
/// Immuable : ni modifie, ni supprime, ni reecrit. Un message n'apparait que
/// lorsqu'un tour a reellement abouti — un echec du fournisseur n'en laisse
/// aucun, et le brouillon de l'utilisateur lui reste acquis.
model ArchitectMessage {
  id        String @id @default(cuid())
  sessionId String

  /// Numero attribue a l'insertion, unique dans la session et jamais modifie.
  sequence Int

  /// Valeur de `ArchitectMessageRole` : `USER` ou `ARCHITECT`.
  role String

  /// Texte reellement envoye, ou reponse **publique** de l'architecte.
  ///
  /// Aucun raisonnement interne n'est demande au modele, ni recu, ni stocke ici.
  content String

  /// Generation du tour auquel ce message appartient.
  ///
  /// Les deux messages d'un meme tour — celui de l'utilisateur et la reponse —
  /// portent le meme identifiant : c'est ce qui permet de retrouver le modele,
  /// la consommation et le manifest d'une reponse donnee.
  generationId String?

  createdAt DateTime @default(now())

  session    ArchitectSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  generation ArchitectGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@index([sessionId, sequence])
}

/// Un appel au fournisseur, et ce qu'il a rendu.
///
/// ## Pourquoi un enfant plutot qu'un ecrasement
///
/// Parce qu'une generation est un fait : elle a consomme des jetons et produit un
/// resultat. La remplacer par la suivante effacerait la question posee au tour
/// precedent, la consommation, et la possibilite de comparer deux propositions.
///
/// Une generation terminee est **immuable** : la couche d'ecriture refuse de
/// modifier une ligne qui n'est plus `RUNNING`.
///
/// ## Ce qui n'est pas stocke
///
/// Ni le prompt complet, ni les documents envoyes. `inputHash` identifie l'entree
/// logique — version de prompt, demande, precisions, manifest, contenu envoye,
/// modele — sans la conserver ; `contextManifestJson` dit avec quoi la
/// proposition a ete produite. Aucune cle, aucun secret, aucun chemin absolu.
model ArchitectGeneration {
  id        String @id @default(cuid())
  sessionId String

  /// Numero attribue a la creation, unique dans la session et jamais modifie.
  sequence Int

  /// Modele effectivement utilise, tel que le serveur l'a lu dans sa configuration.
  model String

  /// Version du prompt, pour qu'un changement de consignes soit detectable.
  promptVersion String

  /// Empreinte deterministe de l'entree logique. Diagnostic, jamais securite.
  inputHash String

  /// `ArchitectContextManifest` serialise.
  contextManifestJson String

  /// Valeur de `ArchitectGenerationStatus`.
  status String

  /// Valeur de `ArchitectTurnState`, depuis TASK-014. `null` pour les
  /// generations enregistrees avant, qui n'etaient pas des tours.
  turnState String?

  /// Empreinte deterministe du contexte reellement envoye.
  ///
  /// Elle repond a une seule question : « ce contexte est-il exactement celui
  /// que l'utilisateur a prévisualisé ? ». Ce n'est pas une primitive de
  /// securite, contrairement a l'empreinte de dossier de travail de TASK-012.
  contextFingerprint String?

  /// `ArchitectTaskProposal` serialise, lorsqu'une proposition a ete validee.
  proposalJson String?

  /// Questions posees, serialisees. Redondant avec la proposition, et utile :
  /// une generation `NEEDS_INPUT` se relit sans deserialiser toute la proposition.
  questionsJson String?

  /// Identifiant de reponse rapporte par le fournisseur, lorsqu'il en fournit un.
  providerResponseId String?

  /// Consommation **rapportee**. Jamais estimee, jamais convertie en cout.
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  cachedInputTokens Int?

  /// Valeur de `ArchitectErrorCode`, lorsque la generation a echoue.
  errorCode String?

  /// Tache creee a partir de la proposition de cette generation.
  ///
  /// ## L'invariant central de TASK-020
  ///
  /// Une conversation de projet cree plusieurs taches au fil des mois ; une
  /// **proposition**, elle, n'en cree jamais deux. L'index unique porte donc ici,
  /// une generation plus bas que `ArchitectSession.appliedTaskId` — c'est
  /// exactement ce deplacement qui fait passer de « une conversation, une tache »
  /// a « une conversation, plusieurs taches ».
  ///
  /// `Restrict` comme sur la session : une tache creee depuis une proposition
  /// n'est pas supprimable tant que cette proposition la designe. Le lien de
  /// provenance vaut mieux qu'une suppression silencieuse.
  appliedTaskId String?

  /// Moment ou le droit de creer la tache a ete reserve.
  ///
  /// Reserver **avant** de creer, jamais l'inverse : sans cela, un double clic
  /// produirait deux taches, dont une seule serait rattachee. La seconde serait
  /// un doublon orphelin, avec son numero et son document Markdown.
  ///
  /// Cette colonne distingue « reservee » de « creee ». `appliedTaskId` reste
  /// `null` entre les deux, et le redevient si la creation echoue. C'est le role
  /// que joue le statut `APPLIED` pour une session historique.
  taskClaimedAt DateTime?

  createdAt DateTime @default(now())

  /// `Cascade` comme `RunEvent` : une generation ne raconte rien sans sa session.
  session       ArchitectSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  appliedTask   Task?                   @relation("TaskFromGeneration", fields: [appliedTaskId], references: [id], onDelete: Restrict)
  messages      ArchitectMessage[]
  projectUpdate ArchitectProjectUpdate?

  @@unique([sessionId, sequence])
  @@unique([appliedTaskId])
  @@index([sessionId, sequence])
}


/// Une dependance explicite entre deux taches du meme projet.
///
/// ## La convention, une fois pour toutes
///
/// `taskId` **attend** `dependsOnTaskId`. La premiere ne peut pas demarrer une
/// nouvelle execution tant que la seconde n'est pas terminee. Les noms des deux
/// relations le redisent : `task` est celle qui attend, `dependsOn` celle qui
/// est attendue.
///
/// ## Pourquoi une table plutot que deux colonnes
///
/// Une tache attend zero, une ou plusieurs taches. C'est une vraie relation
/// plusieurs-a-plusieurs, contrairement a la provenance d'un backlog, ou une
/// tache vient d'au plus une proposition.
///
/// ## Les deux actions de suppression, et pourquoi elles different
///
/// `Cascade` cote `task` : supprimer une tache emporte ce qu'elle attendait.
/// L'arete n'a plus de sujet, et personne ne la regrettera.
///
/// `Restrict` cote `dependsOn` : supprimer une tache **attendue par une autre**
/// est refuse. C'est la meme regle que la provenance de backlog — retracer un
/// plan humain vaut mieux qu'une suppression silencieuse. Le refus est aussi
/// verifie dans la transaction applicative ; cette contrainte le double, et c'est
/// voulu : une garantie structurelle ne depend pas de la discipline de
/// l'appelant.
///
/// Consequence assumee pour la suite : une suppression de projet devra retirer
/// ces lignes **avant** les taches, en une operation explicite. C'est un
/// `deleteMany` de plus, pas un obstacle.
model TaskDependency {
  id String @id @default(cuid())

  /// La tache qui attend.
  taskId String

  /// La tache attendue.
  dependsOnTaskId String

  createdAt DateTime @default(now())

  task      Task @relation("TaskDependencyFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependencyTo", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  /// Une arete au plus entre deux taches donnees.
  ///
  /// Ajouter deux fois la meme dependance n'est pas une erreur metier : c'est un
  /// double-clic. La contrainte rend l'operation idempotente sans qu'aucun code
  /// n'ait a lire avant d'ecrire.
  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

/// Inscription d'une tache dans la file d'execution de son projet.
///
/// ## Pourquoi une ligne plutot qu'un statut
///
/// Parce que « ou en est ce travail » et « est-il autorise a partir » sont deux
/// questions differentes, comme les dependances de TASK-024. Une tache en file
/// reste `READY` : sa presence ici dit l'intention, et rien d'autre. Un statut
/// `QUEUED` aurait fait bouger `Task.status` sans geste humain, et aurait rendu
/// impossible de distinguer une tache prete d'une tache prete **et** inscrite.
///
/// ## Ce que la ligne survit
///
/// Elle ne disparait pas quand l'execution demarre. Elle reste pendant
/// `RUNNING`, pendant `REVIEW`, pendant une correction, et **apres un `Reopen`
/// qui ramene la tache a `READY`** — jusqu'a ce que la tache soit acceptee, ou
/// qu'un humain la retire. Tant qu'elle est la, la file ne passe pas a la
/// suivante : un travail commence depuis la file mais non accepte n'est pas un
/// travail termine. C'est `startedAt` qui rend ce dernier cas distinguable.
model TaskQueueEntry {
  id String @id @default(cuid())

  projectId String
  taskId    String

  /// Position dans la file, attribuee par `Project.nextQueueSequence`.
  ///
  /// Les positions ne sont ni contigues, ni reutilisees : seul leur **ordre**
  /// compte. Un deplacement echange deux valeurs, il ne renumerote pas la file.
  sequence Int

  createdAt DateTime @default(now())

  /// Instant ou une execution est nee de cette inscription, ou `null`.
  ///
  /// La seule chose que `Task.status` ne sait pas dire. Une tache rouverte apres
  /// une relecture redevient `READY`, exactement comme une tache jamais lancee ;
  /// sans cette colonne, la file les confondrait et relancerait la premiere en
  /// croyant demarrer la seconde.
  ///
  /// Elle n'est jamais remise a `null` : une inscription qui a commence son cycle
  /// reste la barriere de la file jusqu'a ce que la tache soit acceptee — l'entree
  /// disparait alors — ou qu'un humain la retire. Reinscrire une tache cree une
  /// ligne neuve, dont le cycle recommence.
  ///
  /// Un instant plutot qu'un booleen : il ne coute pas plus cher et se lit dans
  /// une base ouverte a la main.
  startedAt DateTime?

  /// `Cascade` des deux cotes : une inscription ne decrit rien sans sa tache, et
  /// rien sans son projet. C'est le seul lien de NOX ou `Cascade` va de soi —
  /// une entree de file ne porte aucune histoire a preserver.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Une tache n'apparait qu'une fois dans la file.
  ///
  /// Deux inscriptions simultanees de la meme tache ne produisent donc qu'une
  /// ligne, sans qu'aucun code n'ait a lire avant d'ecrire.
  @@unique([projectId, taskId])
  @@unique([taskId])
  @@index([projectId, sequence])
}

/// Un passage de NOX sur les validations autonomes d'une execution.
///
/// ## Pourquoi une table plutot qu'un drapeau sur `Run`
///
/// Parce qu'elle est la **reservation** qui rend le lot idempotent. Deux
/// finalisations concurrentes de la meme execution passeraient toutes les deux
/// une verification en memoire ; elles ne peuvent pas toutes les deux inserer
/// une ligne active. L'unicite partielle vit dans l'index de la migration, ou
/// un verrou de processus n'aurait survecu ni a un redemarrage, ni a deux
/// serveurs.
///
/// ## Pourquoi `attempt`
///
/// Parce qu'une panne d'infrastructure merite une seconde tentative sans
/// effacer la premiere. Une commande qui echoue vraiment, elle, n'a pas de
/// seconde chance : le code n'a pas change, et c'est `Request changes` qui
/// s'applique.
model AutonomousValidationBatch {
  id    String @id @default(cuid())
  runId String

  /// Numero de tentative, a partir de 1. Une nouvelle tentative n'efface rien.
  attempt Int

  /// Valeur de `ValidationBatchStatus`.
  status String

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  /// Cause d'un lot `ERROR`, telle que NOX l'a constatee.
  errorCode    String?
  errorMessage String?

  /// Etat Git suivi, releve avant et apres les validations.
  ///
  /// Sert a une seule question : la preuve a-t-elle modifie le travail qu'elle
  /// evaluait ? Deux empreintes plutot qu'un diff — on cherche a savoir si
  /// quelque chose a bouge, pas quoi.
  trackedStateBefore String?
  trackedStateAfter  String?

  /// Fichiers suivis qu'une validation a modifies, un par ligne.
  ///
  /// Repond a « quoi », quand les deux empreintes ci-dessus disent seulement
  /// « quelque chose ». Sert a nommer le probleme dans un contexte de
  /// correction ; ne decide jamais d'une completion automatique, qui reste
  /// tranchee par les empreintes.
  ///
  /// `null` signifie « NOX ne sait pas » — runner anterieur, ou etat suivi
  /// illisible avant ou apres. Une chaine vide signifierait « aucun », ce qui
  /// n'est pas la meme chose.
  mutatedFiles String?

  run     Run                         @relation(fields: [runId], references: [id], onDelete: Cascade)
  results AutonomousValidationResult[]

  @@unique([runId, attempt])
  @@index([runId])
}

/// Ce qu'une commande a rendu quand **NOX** l'a executee.
///
/// A ne pas confondre avec `RunValidationResult`, qui enregistre ce que Claude
/// Code a rapporte avoir lance pendant son travail. Les deux tables coexistent
/// volontairement : la premiere est une information, la seconde est une preuve.
/// Les fusionner aurait fait disparaitre la distinction que TASK-027 existe pour
/// etablir.
model AutonomousValidationResult {
  id      String @id @default(cuid())
  batchId String

  /// Rang d'execution dans le lot, deterministe.
  position Int

  /// Commande de la tache dont ce resultat est la preuve.
  ///
  /// Une colonne, pas une relation Prisma — meme raison que `parentRunId` sur
  /// `Run`. Une tache future peut voir ses commandes reecrites ; l'histoire
  /// d'une execution passee ne doit ni disparaitre, ni imposer un ordre de
  /// suppression supplementaire. Le texte execute, lui, est recopie juste en
  /// dessous et se suffit a la relecture.
  commandId String?

  /// Texte exact execute, recopie au lancement.
  command String

  /// Valeur de `AutonomousValidationStatus`.
  status String

  exitCode   Int?
  durationMs Int?

  /// Sorties bornees. La troncature est annoncee, jamais silencieuse.
  stdout          String?
  stdoutTruncated Boolean @default(false)
  stderr          String?
  stderrTruncated Boolean @default(false)

  createdAt DateTime @default(now())

  batch AutonomousValidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, position])
  @@index([batchId])
  @@index([commandId])
}

/// Comment la review d'une execution a ete conclue.
///
/// ## Pourquoi la source est enregistree
///
/// Parce qu'ecrire « approuve par l'utilisateur » quand personne n'a clique
/// serait un mensonge dans l'historique — celui qu'on decouvre des mois plus
/// tard en cherchant qui a valide quoi. Trois sources, et elles ne se
/// remplacent pas : NOX, un humain, ou un humain **malgre** une validation en
/// echec.
///
/// ## Ce qu'un passage en force ne fait pas
///
/// Il ne reecrit aucun resultat. Le lot reste `FAILED`, les commandes gardent
/// leur code de sortie, et cette ligne enregistre seulement qu'un humain a
/// accepte quand meme, avec sa raison.
model RunReviewDecision {
  id    String @id @default(cuid())
  runId String @unique

  /// Valeur de `ReviewDecisionSource`.
  source String

  /// Raison d'un passage en force. Obligatoire pour `HUMAN_OVERRIDE`, nulle sinon.
  overrideReason String?

  decidedAt DateTime @default(now())

  run           Run                          @relation(fields: [runId], references: [id], onDelete: Cascade)
  confirmations RunHumanCriterionConfirmation[]

  @@index([runId])
}

/// Un critere humain qu'une personne a explicitement confirme.
///
/// Le detail compte autant que le geste : « validation humaine confirmee » sans
/// dire **quoi** ne se relit pas six mois plus tard. Le texte du critere est
/// recopie parce qu'une tache future editee ne doit pas reecrire ce qui a ete
/// confirme a l'epoque.
model RunHumanCriterionConfirmation {
  id         String @id @default(cuid())
  decisionId String

  /// Critere confirme, lorsqu'il existe encore.
  criterionId String?

  /// Texte du critere, recopie a la confirmation.
  criterionText String

  createdAt DateTime @default(now())

  decision RunReviewDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, criterionText])
  @@index([decisionId])
}

/// Une correction decidee sur une execution relue.
///
/// ## Pourquoi une table plutot qu'un champ sur `Run`
///
/// Parce qu'elle est la **reservation** qui existe avant l'execution qu'elle
/// autorise. Un champ sur le run de correction ne pourrait etre ecrit qu'une
/// fois ce run cree — c'est-a-dire trop tard pour empecher qu'on en cree deux.
/// C'est le meme raisonnement que `AutonomousValidationBatch` : le point de
/// serialisation doit precede l'action, sans quoi il ne serialise rien.
///
/// ## Ce que la source enregistre
///
/// `HUMAN_FEEDBACK` : quelqu'un a relu et a demande quelque chose.
/// `AUTOMATED_VALIDATION` : NOX possedait lui-meme la preuve d'un echec. Les
/// confondre ferait perdre pourquoi Claude Code a ete relance — la question
/// qu'on se pose six mois plus tard en lisant trois executions d'affilee.
///
/// ## Ce que `attempt` n'est pas
///
/// Ce n'est pas un numero d'execution, ni un compteur de corrections. C'est le
/// rang de **reservation** sur une execution source donnee, a partir de 1 : il
/// existe pour que l'index unique refuse une seconde reservation concurrente
/// tout en laissant une reservation abandonnee etre reprise. Le rang affiche —
/// « correction automatique 1 sur 2 » — vit dans `automatedAttempt`.
model CorrectionAttempt {
  id     String @id @default(cuid())
  taskId String

  /// Execution relue dont cette correction repart.
  sourceRunId String

  /// Lot de validations qui a motive une correction automatique.
  ///
  /// Une colonne, pas une relation : un lot est un fait historique de
  /// l'execution source, et rattacher formellement la reservation a lui
  /// imposerait un ordre de suppression de plus sans rien garantir de neuf.
  sourceBatchId String?

  /// Valeur de `CorrectionSource`.
  source String

  /// Rang de reservation sur `sourceRunId`, a partir de 1.
  attempt Int

  /// Rang de la correction automatique dans le cycle, ou `null` pour un humain.
  ///
  /// Recopie plutot que derive parce qu'il est **decide** au moment de la
  /// reservation, a partir de l'etat d'alors : le relire plus tard donnerait le
  /// compte d'aujourd'hui, pas celui qui a autorise cette correction-la.
  automatedAttempt Int?

  /// Valeur de `CorrectionAttemptStatus`.
  status String

  /// Pourquoi la reservation a ete rendue sans rien lancer.
  refusalCode String?

  createdAt   DateTime  @default(now())
  launchedAt  DateTime?
  abandonedAt DateTime?

  /// Execution nee de cette reservation, une seule fois.
  correctionRunId String?

  /// Feedback humain consomme, lorsqu'il y en avait un.
  ///
  /// `null` pour une correction automatique, et aussi pour une demande humaine
  /// sans texte : quand les preuves de NOX suffisent, l'utilisateur n'a rien a
  /// recopier, et NOX n'invente pas un feedback pour combler la colonne.
  feedbackId String?

  /// `Restrict` comme `Run` et `ReviewFeedback` : une correction est un fait
  /// historique, et elle documente des executions que rien ne supprime.
  task          Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceRun     Run  @relation("CorrectionAttemptSource", fields: [sourceRunId], references: [id], onDelete: Restrict)
  correctionRun Run? @relation("CorrectionAttemptRun", fields: [correctionRunId], references: [id], onDelete: Restrict)

  /// L'index qui compte : deux constatations simultanees du meme echec visent
  /// le meme rang, et une seule l'obtient.
  @@unique([sourceRunId, attempt])
  @@unique([correctionRunId])
  @@index([taskId, createdAt])
  @@index([sourceRunId])
}

/// Une livraison Git : le candidat valide, et ce qu'il est devenu.
///
/// ## Pourquoi une table plutot qu'un champ sur `Task`
///
/// Parce qu'elle est la **reservation** qui existe avant l'ecriture qu'elle
/// autorise. Un champ sur la tache ne pourrait etre ecrit qu'apres le commit —
/// c'est-a-dire trop tard pour empecher qu'on en cree deux. C'est le meme
/// raisonnement que `AutonomousValidationBatch` et `CorrectionAttempt` : le
/// point de serialisation doit preceder l'effet externe, sans quoi il ne
/// serialise rien.
///
/// ## Ce que le candidat prouve
///
/// `expectedHead`, `expectedBranch` et `candidateFingerprint` decrivent l'etat
/// exact du repository au moment de la decision finale. `candidateJson` porte
/// les entrees changees — code de statut et chemin relatif — qui deviendront
/// les pathspecs exacts du `git add`. Ensemble, ils repondent a la seule
/// question qui compte avant d'ecrire : le repository contient-il encore,
/// octet pour octet, le travail qui a ete valide ?
///
/// L'empreinte est un HMAC dont la cle est derivee du jeton du runner et n'est
/// jamais stockee ici — la meme primitive que `Run.workspaceFingerprint`, pour
/// la meme raison, et surtout **pas** une deuxieme implementation. Elle ne
/// quitte jamais le serveur.
///
/// ## Ce que le candidat n'est pas
///
/// Il n'est jamais recalcule. Si le repository diverge, la livraison est
/// bloquee ; elle n'est pas reancree sur l'etat courant en declarant que
/// « maintenant c'est valide ». Il faudrait pour cela une nouvelle validation.
model GitDelivery {
  id        String @id @default(cuid())
  projectId String
  taskId    String

  /// Execution dont le travail est livre, et sa decision de review.
  ///
  /// Toujours presente : une tache simplement marquee terminee n'a ni run, ni
  /// review, ni etat accepte — donc aucun candidat sur a definir.
  sourceRunId      String
  /// Decision de review qui a conclu cette execution, telle qu'elle existait.
  sourceDecisionId String?

  /// Valeur de `DeliveryPolicy`, figee a la reservation.
  ///
  /// Recopiee plutot que relue : changer la politique du projet ne doit ni
  /// annuler un commit deja cree, ni transformer retroactivement une livraison
  /// passee. La nouvelle politique ne gouverne que ce qui n'a pas encore eu
  /// lieu.
  policy String

  /// Valeur de `DeliveryTrigger` : la politique, ou un clic explicite.
  trigger String

  /// Valeur de `DeliveryStatus`.
  status String

  /// Compteur de tentatives, et **le verrou**.
  ///
  /// Chaque action prend la main par une mise a jour conditionnelle sur cette
  /// valeur : deux `Resume delivery` simultanes lisent le meme numero, un seul
  /// reussit a l'incrementer. Jamais un verrou en memoire, qui ne survivrait ni
  /// a un redemarrage, ni a deux processus.
  ///
  /// Il ne recule jamais, echecs compris — comme tous les compteurs de NOX.
  attempt Int @default(0)

  /// Etat du repository au moment de la validation.
  expectedHead         String
  expectedBranch       String
  candidateFingerprint String
  /// Entrees changees du candidat, serialisees.
  candidateJson        String

  /// Upstream de la branche, lorsqu'il en existait un a la reservation.
  ///
  /// NOX n'en configure jamais : ces colonnes enregistrent ce que Git declarait,
  /// et servent a refuser un push dont la destination aurait change entre-temps.
  upstreamRemote String?
  upstreamRef    String?

  /// Message fige a la reservation, trailer compris.
  ///
  /// Jamais recalcule : une reprise apres panne doit commiter exactement le meme
  /// texte, sinon le trailer ne prouverait plus quel commit appartient a quelle
  /// livraison.
  commitMessage String

  /// Commit cree par cette livraison, lorsqu'il existe.
  commitSha String?

  /// Dernier refus ou echec constate. Valeur de `DeliveryRefusalCode`.
  errorCode String?
  /// Sortie Git bornee et assainie, ou message construit par NOX.
  errorMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  committedAt DateTime?
  pushedAt    DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// `Restrict` comme les autres faits historiques : une livraison documente une
  /// tache et une execution, et rien ne les supprime dans son dos.
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceRun Run     @relation(fields: [sourceRunId], references: [id], onDelete: Restrict)

  /// L'index qui compte : dix constatations simultanees de « tache terminee »
  /// visent la meme paire, et une seule obtient sa livraison.
  @@unique([taskId, sourceRunId])
  @@index([projectId, createdAt])
  @@index([taskId])
}
