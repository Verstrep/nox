{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    // Les tests sont executes tels quels par `node --test` : ils importent le
    // package compile, mais restent typecheckes avec le reste des sources.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
