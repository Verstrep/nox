{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    // Les tests sont executes tels quels par `node --test`, qui exige une
    // extension explicite dans les imports relatifs.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
