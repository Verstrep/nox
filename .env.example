# NOX - exemple de configuration locale.
# Copier ce fichier en `.env` a la racine du projet, puis adapter les valeurs.
# Ce fichier ne doit JAMAIS contenir de secret reel.
#
# Ce `.env` unique est lu par les trois processus : le runner, l'application web
# (via `apps/web/next.config.ts`) et le CLI Prisma (via `prisma.config.ts`).

# --- Base de donnees locale (packages/database) ---
# Facultatif. Par defaut, NOX utilise `<racine du monorepo>/data/nox-dev.db`,
# resolu a partir de l'emplacement du package et non du repertoire courant.
# Definir cette variable uniquement pour viser une autre base (essai, bac a sable).
# Format Prisma : "file:" suivi d'un chemin absolu, separateurs `/`.
NOX_DATABASE_URL=

# --- Runner local (apps/runner) ---
# Interface d'ecoute. Le runner refuse de demarrer sur une adresse qui n'est pas
# de la boucle locale : il execute Git et, a terme, Claude Code.
NOX_RUNNER_HOST=127.0.0.1

# Port d'ecoute du serveur HTTP du runner.
NOX_RUNNER_PORT=4310

# --- Application web (apps/web) ---
# Adresse a laquelle l'application web joint le runner.
NOX_RUNNER_URL=http://127.0.0.1:4310

# --- Jeton partage runner <-> web (OBLIGATOIRE) ---
# Le runner et l'application web doivent utiliser EXACTEMENT la meme valeur.
# Le runner refuse de demarrer sans jeton et n'en genere jamais automatiquement :
# une valeur differente a chaque demarrage empecherait le web de l'utiliser.
#
# Generer un jeton local avec Node (le plus court) :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Variante PowerShell native (sans Node) :
#   $bytes = New-Object byte[] 32
#   [System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($bytes)
#   ($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
#
# Ne jamais versionner la valeur reelle : `.env` est ignore par Git.
NOX_RUNNER_TOKEN=replace-with-a-local-random-token

# --- Claude Code (apps/runner) ---
# NOX lance Claude Code avec l'authentification DEJA configuree sur la machine.
# Il ne demande, ne stocke et ne transmet AUCUNE cle d'API Anthropic : si vous
# pouvez lancer `claude` dans un terminal, NOX le peut aussi.

# Nom ou chemin de l'executable Claude Code. Un nom est resolu dans le PATH ;
# sous Windows, un `claude.cmd` genere par npm est reconnu et lance correctement.
# Indiquer un chemin complet si `claude` n'est pas dans le PATH du runner.
NOX_CLAUDE_EXECUTABLE=claude

# Nombre maximal de tours accorde a une execution. Borne entre 1 et 500 : une
# valeur hors bornes est refusee au demarrage, jamais ecretee en silence.
NOX_CLAUDE_MAX_TURNS=80

# Delai maximal d'une execution, en minutes. Borne entre 1 et 600.
# Au-dela, le processus et ses descendants sont arretes, l'etat Git est capture
# tel quel, et l'execution est marquee bloquee. NOX ne restaure rien.
NOX_CLAUDE_TIMEOUT_MINUTES=120

# --- Architecte NOX (apps/web) ---
# L'Architecte est le second modele de NOX : il propose une tache structuree a
# partir du contexte du projet. Claude Code, lui, l'implemente. Les deux ne se
# croisent jamais.
#
# La cle est lue UNIQUEMENT cote serveur. Elle n'atteint jamais le navigateur, et
# n'est jamais transmise a Claude Code : le runner retire toutes les variables
# `NOX_*` de l'environnement du processus enfant. C'est precisement pour cela
# qu'elle s'appelle NOX_OPENAI_API_KEY et non OPENAI_API_KEY.
#
# Ne jamais versionner la valeur reelle : `.env` est ignore par Git.
NOX_OPENAI_API_KEY=

# Modele utilise par l'Architecte. FACULTATIVE : sans elle, NOX utilise le
# modele de ses decisions d'architecture, gpt-5.6-sol, avec un effort de
# raisonnement eleve.
#
# La renseigner est une decision, et NOX ne la reprend pas : la valeur donnee ici
# est utilisee telle quelle. NOX ne connaissant pas les capacites d'un modele
# qu'il n'a pas choisi, il ne lui demande alors aucun effort de raisonnement.
NOX_ARCHITECT_MODEL=

# Il n'existe volontairement aucune variable d'URL de base : NOX envoie du
# contexte projet, et pouvoir rediriger cet envoi vers une adresse arbitraire
# ouvrirait un canal d'exfiltration pour un gain nul.
