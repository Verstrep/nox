# NOX - exemple de configuration locale.
# Copier ce fichier en `.env` puis adapter les valeurs.
# Ce fichier ne doit JAMAIS contenir de secret reel.

# --- Base de donnees locale (packages/database) ---
# Facultatif. Par defaut, NOX utilise `<racine du monorepo>/data/nox-dev.db`,
# resolu a partir de l'emplacement du package et non du repertoire courant.
# Definir cette variable uniquement pour viser une autre base (essai, bac a sable).
# Format Prisma : "file:" suivi d'un chemin absolu, separateurs `/`.
# NOX_DATABASE_URL=file:D:/Projets/Dev/nox/data/nox-bac-a-sable.db

# --- Runner local (apps/runner) ---
# Port d'ecoute du serveur HTTP du runner.
NOX_RUNNER_PORT=4310

# Interface d'ecoute du runner. Rester sur la boucle locale.
NOX_RUNNER_HOST=127.0.0.1

# --- Application web (apps/web) ---
# URL utilisee plus tard par l'application web pour joindre le runner.
NOX_RUNNER_URL=http://127.0.0.1:4310

# --- Reserve pour les taches futures ---
# Aucune cle d'API n'est utilisee a ce stade du projet.
# OPENAI_API_KEY=
